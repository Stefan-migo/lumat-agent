{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "graphify": {
      "type": "local",
      "enabled": true,
      "command": [
        "graphify",
        "mcp",
        "--project-dir",
        "/home/stefan/repos/lumat-agent"
      ],
      "_description": "Graphify \u2014 knowledge graph queries via MCP"
    },
    "engram": {
      "type": "local",
      "command": [
        "engram",
        "mcp"
      ],
      "enabled": true,
      "_note": "Persistent Hippocampus memory. 19 tools: mem_save, mem_search, mem_judge, session lifecycle, FTS5 search."
    }
  },
  "plugin": [
    ".opencode/plugins/graphify.js"
  ],
  "agent": {
    "cortex-planner": {
      "mode": "primary",
      "model": "anthropic/claude-sonnet-4-20250514",
      "temperature": 0.3,
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny"
        },
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "webfetch": "allow",
        "skill": "allow",
        "task": {
          "*": "allow"
        }
      },
      "__managed_by": "cortex"
    },
    "cortex-developer": {
      "mode": "primary",
      "model": "anthropic/claude-sonnet-4-20250514",
      "temperature": 0.2,
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "todowrite": "allow",
        "skill": "allow",
        "task": {
          "*": "allow"
        }
      },
      "__managed_by": "cortex"
    }
  }
}
