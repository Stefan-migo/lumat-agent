graph TD
    subgraph "Orquestador Central"
        ORCH[Orquestador<br/>LangGraph]
        ROUTER[Router de Agentes]
        AUDIT[Registro de Auditoría]
    end

    subgraph "Agentes Especializados"
        AG_WA[Agente WhatsApp<br/>Atención al Cliente]
        AG_CAL[Agente Calendario<br/>Agenda + Google Cal]
        AG_AUT[Agente Automatizaciones<br/>Reglas de Negocio]
        AG_NOT[Agente Notificaciones<br/>WhatsApp + Email]
        AG_REP[Agente Reportes<br/>KPIs + Exportación]
    end

    subgraph "Sistema de Herramientas"
        TOOLS[Herramientas con<br/>Permisos Granulares]
    end

    subgraph "Sistema de Roles"
        ROLES["Dueño &#124; Admin &#124; Técnico &#124; Cliente"]
    end

    subgraph "Memoria y Contexto"
        MEM[Memoria de Conversación]
        CTX[Contexto del Cliente]
    end

    subgraph "Base de Conocimiento"
        KB[(RAG + pgvector)]
    end

    ORCH --> ROUTER
    ORCH --> AUDIT
    ROUTER --> AG_WA
    ROUTER --> AG_CAL
    ROUTER --> AG_AUT
    ROUTER --> AG_NOT
    ROUTER --> AG_REP

    AG_WA --> TOOLS
    AG_CAL --> TOOLS
    AG_AUT --> TOOLS
    AG_NOT --> TOOLS
    AG_REP --> TOOLS

    TOOLS --> ROLES
    ORCH --> MEM
    ORCH --> CTX
    AG_WA --> KB

    style AG_WA fill:#2563eb,color:#fff
    style AG_CAL fill:#93c5fd,color:#1e3a5f
    style AG_AUT fill:#93c5fd,color:#1e3a5f
    style AG_NOT fill:#93c5fd,color:#1e3a5f
    style AG_REP fill:#93c5fd,color:#1e3a5f
