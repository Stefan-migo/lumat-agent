FROM ghcr.io/astral-sh/uv:python3.14-bookworm-slim

# This development container renders PDFs, normalizes audio and transcribes it;
# the upstream uv image carries no pango, no ffmpeg and no OpenMP runtime.
#   ffmpeg/ffprobe — outbound audio normalization and the voice-note duration probe
#   libgomp1       — ctranslate2 (faster-whisper) needs libgomp.so.1
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz-subset0 libfontconfig1 libgdk-pixbuf-2.0-0 shared-mime-info fonts-dejavu-core ffmpeg libgomp1 \
    && rm -rf /var/lib/apt/lists/*
