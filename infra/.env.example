# LumatAgent local dev environment (T1.3; design deployment step 1).
#
# Copy this file to infra/.env and fill in real values — infra/.env is
# gitignored (SH-2: secrets NEVER in the repo). Only this template with
# "change-me" placeholders is committed.
#
#   cp infra/.env.example infra/.env   # then edit infra/.env
#
# The `app` DB role is created by db/migrate.sh with password from
# APP_DB_PASSWORD (default "app" for local dev; set it here for a shared dev
# DB). DATABASE_URL below is the app-role URL used by the API.

# --- Webhook (WH-1, WH-2) ---------------------------------------------------
APP_SECRET=change-me-webhook-hmac-secret
VERIFY_TOKEN=change-me-verify-token

# --- Database (postgres pgvector) -------------------------------------------
# Superuser password for the compose `db` service (used by migrate.sh).
POSTGRES_PASSWORD=change-me-postgres-password
# Password for the least-privilege `app` role created by db/migrate.sh.
APP_DB_PASSWORD=app
# App-role connection URL (host `db` inside compose; localhost on the host).
DATABASE_URL=postgresql+psycopg://app:app@db:5432/lumat

# --- External providers (design D3) -----------------------------------------
OPENAI_API_KEY=change-me-openai-api-key
META_ACCESS_TOKEN=change-me-meta-access-token
META_PHONE_NUMBER_ID=change-me-meta-phone-number-id

# --- Admin panel (design D7, AP-1) ------------------------------------------
# Secret used to SIGN the panel session cookie — a long random value.
PANEL_SESSION_SECRET=change-me-panel-session-secret
# Initial admin account seeded by db/seed.sh at deploy (T7.2, design deploy
# step 4) — a bcrypt hash is computed from PANEL_ADMIN_PASSWORD at seed time;
# the plaintext is read from infra/.env only and NEVER committed (SH-2).
# The seed is idempotent: an existing username is left untouched (first seed
# wins), so a re-deploy never resets the panel password.
PANEL_ADMIN_USERNAME=change-me-admin-username
PANEL_ADMIN_PASSWORD=change-me-initial-admin-password

# --- Prod monitoring (T7.1, SH-3; read by infra/monitor.sh SMTP alert) ------
# On the VPS, export these for the monitor cron job (see docs/hardening.md §8).
# SMTP_PORT defaults to 587 (monitor.sh). For an unauthenticated relay,
# remove the SMTP_USER/SMTP_PASS lines entirely.
SMTP_HOST=change-me-smtp-host
SMTP_FROM=change-me-alerts@lumat.cl
SMTP_TO=change-me-oncall@lumat.cl
SMTP_USER=change-me-smtp-user
SMTP_PASS=change-me-smtp-password
