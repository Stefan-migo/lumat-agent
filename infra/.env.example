# LumatAgent local dev environment (T1.3; design deployment step 1).
#
# Copy this file to infra/.env and fill in real values — infra/.env is
# gitignored (SH-2: secrets NEVER in the repo). Only this template with
# "change-me" placeholders is committed.
#
#   cp infra/.env.example infra/.env   # then edit infra/.env
#
# The `app` DB role is created by db/migrate.sh with password from
# APP_DB_PASSWORD (default "app" for local dev; set it here for a shared dev
# DB). DATABASE_URL below is the app-role URL used by the API.

# --- Webhook (WH-1, WH-2) ---------------------------------------------------
APP_SECRET=change-me-webhook-hmac-secret
VERIFY_TOKEN=change-me-verify-token

# --- Database (postgres pgvector) -------------------------------------------
# Superuser password for the compose `db` service (used by migrate.sh).
POSTGRES_PASSWORD=change-me-postgres-password
# Superuser password for the compose `db-test` service (the isolated
# per-worktree test database). This is the single declaration: compose reads
# it through --env-file and infra/test-db.sh reads it to build the admin URL.
# tests/_testdb.py deliberately has no hardcoded fallback.
TEST_POSTGRES_PASSWORD=change-me-test-postgres-password
# Password for the least-privilege `app` role created by db/migrate.sh.
APP_DB_PASSWORD=app
# App-role connection URL (host `db` inside compose; localhost on the host).
DATABASE_URL=postgresql+psycopg://app:app@db:5432/lumat

# --- External providers (design D3) -----------------------------------------
# Chat is multi-provider via the OpenAI chat-completions protocol: DeepSeek
# (default) or OpenRouter — only base_url + model + key change. Set
# CHAT_PROVIDER and the ACTIVE provider's key; the other key can stay empty.
CHAT_PROVIDER=deepseek
DEEPSEEK_API_KEY=change-me-deepseek-api-key
OPENROUTER_API_KEY=change-me-openrouter-api-key
# Chat model for the active provider (deepseek-chat for DeepSeek; for
# OpenRouter use e.g. openai/gpt-4o-mini).
CHAT_MODEL=deepseek-chat
# Panel assistant (AgentChat) provider — independent from the WhatsApp chat
# provider above. Point it at DeepSeek to reuse DEEPSEEK_API_KEY, or at
# OpenRouter (then OPENROUTER_API_KEY must be a REAL key, not the placeholder).
ASSISTANT_CHAT_PROVIDER=deepseek
ASSISTANT_CHAT_MODEL=deepseek-flash
BRAVE_SEARCH_API_KEY=change-me-brave-api-key
# Local multilingual embeddings (fastembed, ONNX Runtime — no API key, 384d).
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_DIMS=384
# Host directory the api container mounts at /tmp/fastembed_cache, so it
# reuses the downloaded ONNX model instead of re-fetching ~241MB from the HF
# Hub on every recreate. Point it at a durable host path — an empty value
# falls back to that host's /tmp/fastembed_cache.
EMBED_CACHE_DIR=/home/change-me/.cache/lumat-fastembed
META_ACCESS_TOKEN=change-me-meta-access-token
META_PHONE_NUMBER_ID=change-me-meta-phone-number-id

# --- Admin panel (design D7, AP-1) ------------------------------------------
# Secret used to SIGN the panel session cookie — a long random value.
PANEL_SESSION_SECRET=change-me-panel-session-secret
# Initial admin account seeded by db/seed.sh at deploy (T7.2, design deploy
# step 4) — a bcrypt hash is computed from PANEL_ADMIN_PASSWORD at seed time;
# the plaintext is read from infra/.env only and NEVER committed (SH-2).
# The seed is idempotent: an existing username is left untouched (first seed
# wins), so a re-deploy never resets the panel password.
PANEL_ADMIN_USERNAME=change-me-admin-username
PANEL_ADMIN_PASSWORD=change-me-initial-admin-password

# --- Prod monitoring (T7.1, SH-3; read by infra/monitor.sh SMTP alert) ------
# On the VPS, export these for the monitor cron job (see docs/hardening.md §8).
# SMTP_PORT defaults to 587 (monitor.sh). For an unauthenticated relay,
# remove the SMTP_USER/SMTP_PASS lines entirely.
SMTP_HOST=change-me-smtp-host
SMTP_FROM=change-me-alerts@lumat.cl
SMTP_TO=change-me-oncall@lumat.cl
SMTP_USER=change-me-smtp-user
SMTP_PASS=change-me-smtp-password

# --- Panel-configurable model API key (encrypted at rest) -------------------
# KEK for the AES-256-GCM keystore. Optional at boot; required only when an
# admin saves a model API key from the panel. The KEK lives in env, the
# ciphertext in the DB — a leaked DB dump alone does not expose the key.
# Generate: python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
SETTINGS_ENCRYPTION_KEY=change-me-settings-encryption-key
