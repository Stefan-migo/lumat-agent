[Unit]
# LumatAgent certificate renewal — runs the compose `certbot` service
# (webroot renewal) and reloads nginx so it picks up fresh certs.
#
# `--project-name lumat` is REQUIRED on the compose command. Without it Compose
# derives the project name from the `infra/` directory, so every volume in the
# file is scoped to a project called `infra` and the renewal operates on
# `infra_certbot-certs` instead of the `lumat_certbot-certs` volume nginx
# mounts. That failure is SILENT: `renew` finds no lineage, exits 0, and the
# certificate nginx actually serves is never renewed until it expires.
#
# ExecStart also has to resolve GIT_SHA, because `infra/docker-compose.prod.yml`
# guards `services.api.build.args.GIT_SHA` with `${GIT_SHA:?}` and `compose run`
# interpolates the whole file even for a service that does not build. The unit
# runs as root while the checkout belongs to `deploy`, so git refuses to read
# HEAD (`detected dubious ownership`) unless `-c safe.directory` names the path.
Description=LumatAgent Let's Encrypt certificate renewal (compose certbot)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/lumat
# The certbot service carries `command: renew --webroot -w /var/www/certbot`;
# `docker compose run` executes it in a fresh container.
ExecStart=/bin/sh -c 'GIT_SHA=$(git -c safe.directory=/opt/lumat rev-parse --short HEAD) exec /usr/bin/docker compose --project-name lumat --profile certbot -f infra/docker-compose.yml -f infra/docker-compose.prod.yml run --rm certbot'
# The reload goes straight to the running container instead of through Compose:
# `docker exec` needs neither project-name resolution nor GIT_SHA, so this step
# cannot be broken by the `${GIT_SHA:?}` interpolation ExecStart requires. The
# container name is stable because every Compose command pins `--project-name
# lumat`, which fixes the `lumat-` prefix.
ExecStartPost=/usr/bin/docker exec lumat-nginx-1 nginx -s reload
